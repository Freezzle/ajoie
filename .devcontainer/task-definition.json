{
  "family": "ajoie-task",
  "containerDefinitions": [
    {
      "name": "ajoie",
      "image": "038462792625.dkr.ecr.eu-north-1.amazonaws.com/ajoie:latest",
      "memory": 512,
      "cpu": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080
        }
      ],
      "environment": [
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:postgresql://db-ajoie.cfc4gsekgpii.eu-north-1.rds.amazonaws.com:5432/db-ajoie" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "salon" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "value": "AjoieDeMieuxVivre" }
      ]
    }
  ],
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::038462792625:role/AWSServiceRoleForECS"
}
