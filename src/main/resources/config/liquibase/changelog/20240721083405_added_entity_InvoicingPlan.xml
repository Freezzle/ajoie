<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Added the entity InvoicingPlan.
    -->
    <changeSet id="20240721083405-1" author="claudedy">
        <createTable tableName="invoicing_plan">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="generation_date" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="issued_date" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="expiration_date" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="need_arrangement" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="billing_number" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="state" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="participation_id" type="${uuidType}">
                <constraints nullable="true"/>
            </column>

        </createTable>
        <dropDefaultValue tableName="invoicing_plan" columnName="generation_date" columnDataType="${datetimeType}"/>
    </changeSet>

    <changeSet id="202511161111-1" author="dylan">
        <addColumn tableName="invoicing_plan">
            <column name="invoice_sending_method" type="varchar(50)" defaultValue="EMAIL">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
