<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Added the entity Exhibitor.
    -->
    <changeSet id="20240721083401-1" author="claudedy">
        <createTable tableName="exhibitor">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="registration_date" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="language" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="full_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="phone_number" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="address" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="npa_localite" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="extra_information" type="varchar(500)">
                <constraints nullable="true"/>
            </column>

        </createTable>
    </changeSet>

    <changeSet id="add-billing-address" author="freezzle">
        <addColumn tableName="exhibitor">
            <column name="billing_address_id" type="${uuidType}">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <addColumn tableName="exhibitor">
            <column name="different_billing_address" type="boolean" defaultValue="false">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20251102-add-newsletter" author="freezzle">
        <addColumn tableName="exhibitor">
            <column name="newsletter" type="boolean" defaultValue="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20251108-add-attributes" author="freezzle">
        <addColumn tableName="exhibitor">
            <column name="red_flag" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="exhibitor">
            <column name="duplicate_detected" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

    </changeSet>
</databaseChangeLog>
