<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-address-table" author="freezzle">
        <createTable tableName="address">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="formal_line" type="VARCHAR(255)"/>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="postal_case" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="npa_localite" type="VARCHAR(255)"/>
            <column name="extra_line" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
