<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- Ordre d'affichage des dimensions/prix d'un salon -->
    <changeSet id="0.0.2-202611-price-stand-position" author="freezzle">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="price_stand_salon"/>
            <not>
                <columnExists tableName="price_stand_salon" columnName="sort_order"/>
            </not>
        </preConditions>

        <addColumn tableName="price_stand_salon">
            <column name="sort_order" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <sql>
            UPDATE price_stand_salon p
            SET sort_order = r.rn
            FROM (SELECT id,
                         ROW_NUMBER() OVER (PARTITION BY salon_id
                                            ORDER BY width_meter, height_meter, LOWER(dimension)) - 1 AS rn
                  FROM price_stand_salon) r
            WHERE p.id = r.id
        </sql>

        <rollback>
            <dropColumn tableName="price_stand_salon" columnName="sort_order"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

