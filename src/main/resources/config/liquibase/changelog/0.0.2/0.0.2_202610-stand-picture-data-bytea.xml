<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!--
        Correctif : la propriété ${blobType} vaut "blob", que PostgreSQL traduit en "oid"
        (large object). Hibernate mappe un byte[] en "bytea", d'où une erreur à l'insertion
        (« column "data" is of type oid but expression is of type bytea »).

        Aucune ligne ne peut exister dans la table : toutes les insertions échouaient. On purge
        donc par sécurité avant de recréer la colonne au bon type.

        NB : on utilise un sqlCheck plutôt que <tableExists>, car cette précondition déclenche un
        snapshot Liquibase qui lit pg_catalog.pg_database — table sur laquelle l'utilisateur de la
        base de prod n'a pas le droit SELECT (« permission denied for table pg_database »).
        La requête ci-dessous couvre à la fois l'existence de la table et le type de la colonne
        (elle retourne 0 si la table est absente, contrairement à un cast ::regclass).
    -->
    <changeSet id="0.0.2-202610-stand-picture-data-bytea" author="freezzle" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT count(*) FROM information_schema.columns
                WHERE table_schema = current_schema()
                  AND table_name = 'stand_picture'
                  AND column_name = 'data'
                  AND data_type = 'oid'
            </sqlCheck>
        </preConditions>

        <sql>
            DELETE FROM stand_picture;
            ALTER TABLE stand_picture DROP COLUMN data;
            ALTER TABLE stand_picture ADD COLUMN data bytea NOT NULL;
        </sql>

        <rollback>
            <sql>
                DELETE FROM stand_picture;
                ALTER TABLE stand_picture DROP COLUMN data;
                ALTER TABLE stand_picture ADD COLUMN data oid NOT NULL;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
