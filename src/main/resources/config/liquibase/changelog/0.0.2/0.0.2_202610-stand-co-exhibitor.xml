<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- Informations du co-exposant partageant le stand -->
    <changeSet id="0.0.2-202610-stand-co-exhibitor" author="freezzle">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="stand"/>
        </preConditions>

        <addColumn tableName="stand">
            <column name="shared_first_name" type="varchar(100)"/>
            <column name="shared_last_name" type="varchar(100)"/>
            <column name="shared_therapist_name" type="varchar(100)"/>
            <column name="shared_email" type="varchar(100)"/>
            <column name="shared_description" type="varchar(500)"/>
            <column name="shared_category" type="varchar(50)"/>
            <column name="shared_sub_categories" type="JSON"/>
            <column name="shared_website" type="varchar(100)"/>
            <column name="shared_instagram" type="varchar(100)"/>
            <column name="shared_facebook" type="varchar(100)"/>
            <column name="shared_url_picture" type="varchar(500)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="stand" columnName="shared_first_name"/>
            <dropColumn tableName="stand" columnName="shared_last_name"/>
            <dropColumn tableName="stand" columnName="shared_therapist_name"/>
            <dropColumn tableName="stand" columnName="shared_email"/>
            <dropColumn tableName="stand" columnName="shared_description"/>
            <dropColumn tableName="stand" columnName="shared_category"/>
            <dropColumn tableName="stand" columnName="shared_sub_categories"/>
            <dropColumn tableName="stand" columnName="shared_website"/>
            <dropColumn tableName="stand" columnName="shared_instagram"/>
            <dropColumn tableName="stand" columnName="shared_facebook"/>
            <dropColumn tableName="stand" columnName="shared_url_picture"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
