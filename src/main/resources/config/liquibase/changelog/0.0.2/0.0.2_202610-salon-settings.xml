<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!--
        Réglages d'un salon partagés par tous les administrateurs. Pour l'instant, la seule
        donnée stockée est le choix des métriques affichées dans le tableau de bord
        (« Mes indicateurs »). Il y en a un seul par salon.
    -->

    <changeSet id="0.0.2-202610-salon-settings" author="freezzle">
        <createTable tableName="salon_settings">
            <column name="id" type="${uuidType}">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="tenant_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="salon_id" type="${uuidType}">
                <constraints nullable="false"/>
            </column>
            <column name="data" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="salon_settings" indexName="idx_salon_settings_tenant_id">
            <column name="tenant_id"/>
        </createIndex>

        <createIndex tableName="salon_settings" indexName="ux_salon_settings_salon_id" unique="true">
            <column name="salon_id"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="salon_id"
                                 baseTableName="salon_settings"
                                 constraintName="fk_salon_settings__salon_id"
                                 referencedColumnNames="id"
                                 referencedTableName="salon"/>

        <addForeignKeyConstraint baseColumnNames="tenant_id"
                                 baseTableName="salon_settings"
                                 constraintName="fk_salon_settings__tenant_id"
                                 referencedColumnNames="id"
                                 referencedTableName="tenant"
                                 onDelete="RESTRICT"
                                 onUpdate="RESTRICT"/>
    </changeSet>

</databaseChangeLog>
