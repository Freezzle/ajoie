<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- =====================================================
         Create tenant table
         ===================================================== -->
    <changeSet id="0.0.2_202601-001-create-tenant-table" author="tenant-system">
        <createTable tableName="tenant">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_tenant_slug"/>
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="tenant" indexName="idx_tenant_slug">
            <column name="slug"/>
        </createIndex>
    </changeSet>

    <!-- =====================================================
         Add tenant-related columns to jhi_user table
         ===================================================== -->
    <changeSet id="0.0.2_202601-002-add-tenant-columns-to-user" author="tenant-system">
        <addColumn tableName="jhi_user">
            <column name="tenant_id" type="${uuidType}"/>
            <column name="tenant_owner" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_member_status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="jhi_user" indexName="idx_user_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <!-- =====================================================
         Create default tenant "L'Ajoie de mieux vivre"
         Uses a fixed UUID for determinism
         ===================================================== -->
    <changeSet id="0.0.2_202601-003-insert-default-tenant" author="tenant-system">
        <insert tableName="tenant">
            <column name="id" value="a8d5c7e1-1234-5678-9abc-def012345678"/>
            <column name="name" value="L'Ajoie de mieux vivre"/>
            <column name="slug" value="ajoie-de-mieux-vivre"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>

    <!-- =====================================================
         Assign all existing users to default tenant
         Set the first admin user (or earliest created) as owner
         ===================================================== -->
    <changeSet id="0.0.2_202601-004-assign-users-to-default-tenant" author="tenant-system" runInTransaction="true">
        <sql>
            UPDATE jhi_user SET tenant_id = 'a8d5c7e1-1234-5678-9abc-def012345678'
            WHERE tenant_id IS NULL;
        </sql>
    </changeSet>

    <!-- Mark admin user as tenant owner if exists -->
    <changeSet id="0.0.2_202601-005-set-admin-as-tenant-owner" author="tenant-system">
        <sql>
            UPDATE jhi_user
            SET tenant_owner = true
            WHERE login = 'admin' AND tenant_id = 'a8d5c7e1-1234-5678-9abc-def012345678';
        </sql>
    </changeSet>

    <!-- If no admin user, mark the earliest created user as owner -->
    <changeSet id="0.0.2_202601-006-set-earliest-user-as-owner-fallback" author="tenant-system">
        <sql>
            UPDATE jhi_user
            SET tenant_owner = true
            WHERE tenant_owner = false
            AND tenant_id = 'a8d5c7e1-1234-5678-9abc-def012345678'
            AND id = (
              SELECT id FROM jhi_user
              WHERE tenant_id = 'a8d5c7e1-1234-5678-9abc-def012345678'
              ORDER BY created_date ASC NULLS LAST
              LIMIT 1
            );
        </sql>
    </changeSet>

    <!-- Add NOT NULL constraint to tenant_id in jhi_user -->
    <changeSet id="0.0.2_202601-007-make-tenant-id-not-null" author="tenant-system">
        <addNotNullConstraint tableName="jhi_user" columnName="tenant_id" columnDataType="${uuidType}"/>
        <addForeignKeyConstraint baseColumnNames="tenant_id"
                                 baseTableName="jhi_user"
                                 constraintName="fk_user__tenant_id"
                                 referencedColumnNames="id"
                                 referencedTableName="tenant"
                                 onDelete="RESTRICT"
                                 onUpdate="RESTRICT"/>
    </changeSet>

