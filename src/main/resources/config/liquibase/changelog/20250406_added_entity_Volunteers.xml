<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250406-0" author="freezzle">
        <createTable tableName="volunteer">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lastname" type="VARCHAR(255)"/>
            <column name="firstname" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone_number" type="VARCHAR(255)"/>
        </createTable>

        <createTable tableName="time_slot">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="salon_id" type="${uuidType}"/>
            <column name="label" type="VARCHAR(100)"/>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="start" type="TIME"/>
            <column name="end" type="TIME"/>
        </createTable>

        <createTable tableName="volunteer_availability">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="volunteer_id" type="${uuidType}"/>
            <column name="time_slot_id" type="${uuidType}"/>
            <column name="category" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
