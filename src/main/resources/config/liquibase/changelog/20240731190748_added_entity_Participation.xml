<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Added the entity Participation.
    -->
    <changeSet id="20240731190748-1" author="claudedy">
        <createTable tableName="participation">
            <column name="id" type="${uuidType}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="registration_date" type="${datetimeType}">
                <constraints nullable="true"/>
            </column>
            <column name="client_number" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="nb_meal_1" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="nb_meal_2" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="nb_meal_3" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="accepted_chart" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="accepted_contract" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="need_arrangement" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="has_offer" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="offer" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="guest_of_honor" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="crush_of_heart" type="boolean" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="additional_information" type="varchar(1000)">
                <constraints nullable="true"/>
            </column>
            <column name="extra_information" type="varchar(500)">
                <constraints nullable="true"/>
            </column>
            <column name="exhibitor_id" type="${uuidType}">
                <constraints nullable="true"/>
            </column>
            <column name="salon_id" type="${uuidType}">
                <constraints nullable="true"/>
            </column>
            <column name="therapist_name" type="varchar(250)">
                <constraints nullable="false"/>
            </column>

        </createTable>
        <dropDefaultValue tableName="participation" columnName="registration_date" columnDataType="${datetimeType}"/>
    </changeSet>

    <changeSet id="20251102-add-attributes-participation" author="freezzle">
        <addColumn tableName="participation">
            <column name="mode_payment_meals" type="varchar(50)" defaultValue="MIXED">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="participation">
            <column name="invoice_sending_method" type="varchar(50)" defaultValue="EMAIL">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
